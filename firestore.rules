rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras de Produção ERP / PDV Ótica Yasmin
    // Operadores e terminais sincronizam coleções do sistema com integridade e contingência offline.
    
    // 1. Coleções Operacionais de Estoque e Catálogo
    match /CAD_ARMACOES/{itemId} {
      allow read, write: if true;
    }
    match /CAD_LENTES/{itemId} {
      allow read, write: if true;
    }
    match /CAD_BRINDES/{itemId} {
      allow read, write: if true;
    }
    match /ESTOQUE/{itemId} {
      allow read, write: if true;
    }
    match /TRANSFERENCIAS_ESTOQUE/{transferId} {
      allow read, write: if true;
    }

    // 2. Vendas, Clientes e Fidelidade / Vouchers
    match /CLIENTES_CADASTRADOS/{clientId} {
      allow read, write: if true;
    }
    match /Registro_Vendas/{saleId} {
      allow read, write: if true;
    }
    match /VOUCHERS/{voucherId} {
      allow read, write: if true;
    }

    // 3. Financeiro e Fluxo de Caixa (Contas a Pagar, Receber, Caixa)
    match /CONTAS_RECEBER/{billId} {
      allow read, write: if true;
    }
    match /CONTAS_PAGAR/{billId} {
      allow read, write: if true;
    }
    match /FLUXO_CAIXA/{entryId} {
      allow read, write: if true;
    }

    // 4. Usuários e Autenticação Interna do Sistema
    match /USUARIOS/{username} {
      allow read, write: if true;
    }

    // 5. Histórico e Itens Excluídos (Contingência e Auditoria)
    match /DELETED_ITEMS/{deletedId} {
      allow read, write: if true;
    }

    // 6. Comunicados e Transmissões em Tempo Real (Broadcast Central)
    match /COMUNICADOS_SISTEMA/{msgId} {
      allow read, write: if true;
    }

    // 7. Catálogo de Acessórios e Metadados do Manifesto
    match /CAD_ACESSORIOS/{itemId} {
      allow read, write: if true;
    }
    match /_METADATA/{metaId} {
      allow read, write: if true;
    }

    // Bloqueia qualquer outro documento não especificado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
